async function fetchAllFiles(repo, path = '') {
  const apiUrl = `https://api.github.com/repos/${repo}/contents/${path}`;
  const res = await fetch(apiUrl);
  const items = await res.json();
  
  let allFiles = [];
  
  for (const item of items) {
    if (item.type === 'file' && /\.(js|jsx|ts|html)$/.test(item.name)) {
      allFiles.push({name: item.name, url: item.download_url});
    } else if (item.type === 'dir') {
      const nestedFiles = await fetchAllFiles(repo, item.path);
      allFiles.push(...nestedFiles);  // Recursive call
    }
  }
  return allFiles;
}
