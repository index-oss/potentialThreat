<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GitHub Deep Scan Console</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #1e1e2f; color: #f5f5f5; font-family: monospace; }
    #output { white-space: pre-wrap; overflow-y: auto; max-height: 70vh; padding: 1rem; border: 1px solid #444; border-radius: 0.5rem; background-color: #111827; }
    .HIGH { color: #f87171; font-weight: bold; }
    .MEDIUM { color: #facc15; font-weight: bold; }
    .LOW { color: #34d399; font-weight: bold; }
    button { transition: all 0.2s; }
    button:hover { transform: scale(1.05); }
  </style>
</head>
<body class="p-4">
  <h1 class="text-2xl font-bold mb-4">GitHub Deep Scan Console</h1>

  <div class="mb-4">
    <input id="repoUrl" type="text" placeholder="Enter public GitHub repo URL" class="p-2 w-full rounded text-black"/>
    <button id="scanBtn" class="mt-2 px-4 py-2 bg-blue-600 rounded hover:bg-blue-700">Start Deep Scan</button>
  </div>

  <div id="status" class="mb-4"></div>
  <pre id="output"></pre>

  <script type="module">
    import { rules, scanCode } from './rules.js';

    const scanBtn = document.getElementById("scanBtn");
    const repoInput = document.getElementById("repoUrl");
    const status = document.getElementById("status");
    const output = document.getElementById("output");

    async function fetchRepoFiles(repoUrl) {
      const match = repoUrl.match(/github\.com\/([^\/]+)\/([^\/]+)/);
      if (!match) throw new Error("Invalid GitHub repo URL.");

      const owner = match[1];
      const repo = match[2];
      const res = await fetch(`https://api.github.com/repos/${owner}/${repo}/git/trees/HEAD?recursive=1`);
      const data = await res.json();
      if (!data.tree) throw new Error("Unable to fetch repo files.");

      const files = data.tree.filter(f => /\.(js|ts|jsx|tsx|html|vue|hbs)$/i.test(f.path));
      return files.map(f => `https://raw.githubusercontent.com/${owner}/${repo}/HEAD/${f.path}`);
    }

    async function fetchFileContent(fileUrl) {
      const res = await fetch(fileUrl);
      return res.text();
    }

    function displayFinding(finding) {
      const line = `[${finding.severity}] ${finding.file} | ${finding.name} | ${finding.description}\n`;
      const span = document.createElement("span");
      span.classList.add(finding.severity.toUpperCase());
      span.textContent = line;
      output.appendChild(span);
    }

    scanBtn.addEventListener("click", async () => {
      output.textContent = "";
      const repoUrl = repoInput.value.trim();
      if (!repoUrl) return alert("Enter a GitHub repo URL.");

      status.textContent = "🔄 Fetching repo files...";
      try {
        const fileUrls = await fetchRepoFiles(repoUrl);
        if (fileUrls.length === 0) {
          status.textContent = "⚠️ No JS/TS/HTML/Vue/Handlebars files found.";
          return;
        }

        status.textContent = `⚡ Scanning ${fileUrls.length} files...`;
        for (let i = 0; i < fileUrls.length; i++) {
          const url = fileUrls[i];
          const content = await fetchFileContent(url);
          const findings = scanCode(content, url);
          findings.forEach(displayFinding);
        }

        status.textContent = `✅ Scan complete. ${output.childNodes.length} issues found.`;
      } catch (err) {
        status.textContent = `❌ Error: ${err.message}`;
      }
    });
  </script>
</body>
</html>
